<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clouder_App.Pages.PoolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Storage Pools" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Click="CreatePool_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Create New Pool" />
                </StackPanel>
            </Button>
            <Button x:Name="MergePoolsBtn" Click="MergePools_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8D5;" FontSize="14" />
                    <TextBlock Text="Merge Pools" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ListView x:Name="PoolsListView" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6" Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <!-- Header row: name + badges -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding LocalPath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{Binding StrategyLabel}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{Binding ModeLabel}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Pool capacity bar -->
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CapacityText}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding UsagePercentText}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ProgressBar Maximum="100" Value="{Binding UsagePercent}" Height="8" CornerRadius="4" />
                            </StackPanel>

                            <!-- Per-member breakdown -->
                            <ItemsRepeater ItemsSource="{Binding MemberDetails}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PriorityBadge}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding AccountName}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="2" Maximum="100" Value="{Binding UsagePercent}"
                                                         Height="4" CornerRadius="2" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding QuotaText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" MinWidth="120" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Tag="{Binding PoolId}" Click="SyncNow_Click" Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Sync all local files to cloud now">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                                        <TextBlock Text="Sync Now" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding PoolId}" Click="OpenInExplorer_Click" ToolTipService.ToolTip="Open pool folder in Explorer">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEC50;" FontSize="12" />
                                        <TextBlock Text="Open" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding PoolId}" Click="ManagePool_Click" ToolTipService.ToolTip="Pool management options">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE713;" FontSize="12" />
                                        <TextBlock Text="Manage" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding PoolId}" Click="EditPriorities_Click"
                                        ToolTipService.ToolTip="Fill order, usage caps and reserved space per account">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                        <TextBlock Text="Accounts" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding PoolId}" Click="EditVersions_Click"
                                        ToolTipService.ToolTip="Where and how long previous versions are kept">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE81C;" FontSize="12" />
                                        <TextBlock Text="Versions" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{Binding PoolId}" Click="EditPool_Click" ToolTipService.ToolTip="Edit pool settings">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                </Button>
                                <Button Tag="{Binding PoolId}" Click="DeletePool_Click" ToolTipService.ToolTip="Delete pool">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
