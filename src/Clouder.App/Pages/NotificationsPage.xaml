<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clouder_App.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Notifications" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshBtn" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Check Now" />
                </StackPanel>
            </Button>
            <Button x:Name="MarkAllReadBtn" Click="MarkAllRead_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                    <TextBlock Text="Mark All Read" />
                </StackPanel>
            </Button>
            <Button x:Name="ConfigureEmailBtn" Click="ConfigureEmail_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE715;" FontSize="14" />
                    <TextBlock Text="Configure Email Monitoring" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Filter bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <ToggleButton x:Name="FilterAll" Content="All" IsChecked="True" Click="Filter_Click" />
            <ToggleButton x:Name="FilterUnread" Content="Unread" Click="Filter_Click" />
            <ToggleButton x:Name="FilterCritical" Content="Critical" Click="Filter_Click" />
            <ToggleButton x:Name="FilterWarning" Content="Warning" Click="Filter_Click" />
            <ToggleButton x:Name="FilterInfo" Content="Info" Click="Filter_Click" />
        </StackPanel>

        <!-- Notification List -->
        <ListView x:Name="NotificationsListView" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="{Binding BorderThickness}"
                            BorderBrush="{Binding BorderBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Severity icon -->
                            <FontIcon Glyph="{Binding SeverityGlyph}" Foreground="{Binding SeverityBrush}"
                                      FontSize="22" VerticalAlignment="Top" Margin="0,2,0,0" />

                            <!-- Content -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}" FontSize="14"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{Binding Body}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding TimeAgo}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding AccountLabelVisibility}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions -->
                            <Button Grid.Column="2" Tag="{Binding NotificationId}" Click="MarkRead_Click"
                                    VerticalAlignment="Top" ToolTipService.ToolTip="Mark as read"
                                    Visibility="{Binding MarkReadVisibility}">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="3" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xED0D;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No notifications" FontSize="16" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Configure email monitoring to watch for account alerts."
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
