<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clouder_App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Clouder_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel Spacing="24" MaxWidth="600">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="About Clouder" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE753;" FontSize="36" />
                        <StackPanel>
                            <TextBlock Text="Clouder" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="Multi-cloud storage manager" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Updates" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="UpdateProgress" Maximum="100" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates"
                                Click="CheckUpdates_Click" />
                        <Button x:Name="RestartButton" Content="Restart now" Visibility="Collapsed"
                                Style="{StaticResource AccentButtonStyle}" Click="Restart_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="What it does" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Clouder pools free-tier cloud storage from Google Drive, MEGA, and other providers into a single virtual filesystem visible in Windows Explorer. Files are placed across providers using configurable strategies (fill-first, round-robin, largest-free) with per-file routing rules and automatic reorganization." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Tech stack" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="20" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Framework" FontWeight="SemiBold" Grid.Row="0" />
                        <TextBlock Text=".NET 8 + WinUI 3" Grid.Row="0" Grid.Column="1" />
                        <TextBlock Text="Database" FontWeight="SemiBold" Grid.Row="1" />
                        <TextBlock Text="SQLite (Microsoft.Data.Sqlite)" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Text="Explorer" FontWeight="SemiBold" Grid.Row="2" />
                        <TextBlock Text="Windows Cloud Files API (CfApi)" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Text="Google Drive" FontWeight="SemiBold" Grid.Row="3" />
                        <TextBlock Text="Google.Apis.Drive.v3 (OAuth2)" Grid.Row="3" Grid.Column="1" />
                        <TextBlock Text="MEGA" FontWeight="SemiBold" Grid.Row="4" />
                        <TextBlock Text="MegaApiClient" Grid.Row="4" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Data location" FontWeight="SemiBold" />
                    <TextBlock x:Name="DataPathText" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LogPathText" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
