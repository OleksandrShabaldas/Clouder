<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clouder_App.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Accounts" />

        <!-- Add Account Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddGoogleBtn" Click="AddGoogle_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Connect Google Drive" />
                </StackPanel>
            </Button>
            <Button x:Name="AddMegaBtn" Click="AddMega_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Connect MEGA" />
                </StackPanel>
            </Button>
            <Button x:Name="RefreshQuotasBtn" Click="RefreshQuotas_Click" ToolTipService.ToolTip="Refresh storage quotas from providers">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh Quotas" />
                </StackPanel>
            </Button>
            <Button x:Name="SetGoogleCredsBtn" Click="SetGoogleCreds_Click"
                    ToolTipService.ToolTip="Enter your Google OAuth Client ID/Secret to restore existing accounts without re-adding them">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE192;" FontSize="14" />
                    <TextBlock Text="Set API Credentials" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Account List -->
        <ListView x:Name="AccountsListView" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding ProviderGlyph}" FontSize="28" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding Email}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding ProviderLabel}" FontSize="11" Foreground="White" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Tag="{Binding AccountId}" Click="Reconnect_Click"
                                            ToolTipService.ToolTip="Reconnect / verify this account">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                    <Button Tag="{Binding AccountId}" Click="Disconnect_Click"
                                            ToolTipService.ToolTip="Disconnect account">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Storage quota bar -->
                            <Grid Visibility="{Binding QuotaVisible}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ProgressBar Maximum="100" Value="{Binding UsagePercent}" Height="6"
                                             CornerRadius="3" Margin="0,4,0,2" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding QuotaUsedText}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding QuotaTotalText}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
