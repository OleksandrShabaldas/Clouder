<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clouder_App.Pages.TransferManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar: categories and media types ──────────────── -->
        <Border Width="230" Padding="12,16,12,12"
                BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transfers" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button x:Name="PauseBtn" Grid.Column="1" Click="TogglePause_Click"
                                ToolTipService.ToolTip="Pause or resume syncing"
                                Padding="7,5" Background="Transparent" BorderThickness="0">
                            <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                        </Button>
                    </Grid>

                    <TextBox x:Name="SearchBox" PlaceholderText="Search by name…"
                             TextChanged="Search_Changed" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Activity" FontSize="11" Margin="4,4,0,4"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ListView x:Name="CategoryList" SelectionMode="Single"
                                  SelectionChanged="Category_Changed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="File type" FontSize="11" Margin="4,12,0,4"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <ListView x:Name="MediaList" SelectionMode="Single"
                                  SelectionChanged="Media_Changed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pooled storage, like MEGA's quota bar -->
                <StackPanel Grid.Row="2" Spacing="4" Padding="4,10,4,0">
                    <TextBlock x:Name="QuotaLabel" Text="Pooled storage" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="QuotaBar" Maximum="100" Value="0" Height="5" CornerRadius="3" />
                    <TextBlock x:Name="QuotaText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main list ────────────────────────────────────────── -->
        <Grid Grid.Column="1" Padding="20,16,20,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                    <TextBlock x:Name="HeadingText" Text="All transfers"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="SubheadingText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="PoolFilter" MinWidth="150" SelectionChanged="PoolFilter_Changed"
                              ToolTipService.ToolTip="Filter by pool" />
                    <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button ToolTipService.ToolTip="Clear history">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Clear completed" Click="ClearCompleted_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Clear all history" Click="ClearAll_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Totals for the current filter -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="14,10" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel>
                        <TextBlock Text="Uploaded" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TotalUpText" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Downloaded" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TotalDownText" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Striped files" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TotalStripedText" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Failed" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="TotalFailedText" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListView x:Name="TransferList" Grid.Row="2" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Transfer_Click">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding MediaGlyph}" FontSize="18" />
                            </Grid>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{Binding DirectionGlyph}" FontSize="10"
                                              Foreground="{Binding DirectionBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2" Visibility="{Binding StripedVisible}"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StripedText}" FontSize="10" />
                            </Border>

                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" MinWidth="72" TextAlignment="Right" />

                            <TextBlock Grid.Column="4" Text="{Binding TimeText}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" MinWidth="72" TextAlignment="Right" />

                            <FontIcon Grid.Column="5" Glyph="{Binding StatusGlyph}" FontSize="14"
                                      Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                      Margin="4,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE8AB;" FontSize="42"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyText" Text="No transfers"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
