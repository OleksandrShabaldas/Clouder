<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clouder_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel Spacing="12" MaxWidth="800">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" Margin="0,0,0,8" />

            <!-- ── General ──────────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xE713;" />
                        <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4,8">
                    <ToggleSwitch x:Name="AutoStartToggle" Header="Auto-start on Windows login"
                                  Toggled="Setting_Changed" />
                    <ToggleSwitch x:Name="TrayToggle" Header="Minimize to system tray on close"
                                  Toggled="Setting_Changed" />
                    <ToggleSwitch x:Name="NotifyToggle" Header="Show sync notifications"
                                  Toggled="Setting_Changed" />
                    <ComboBox x:Name="DefaultStrategyBox" Header="Default placement strategy for new pools"
                              ItemsSource="{x:Bind StrategyOptions}" SelectionChanged="Setting_Changed" />
                </StackPanel>
            </Expander>

            <!-- ── Updates ──────────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xE777;" />
                        <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4,8">
                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="Check for new versions automatically"
                                  Toggled="Setting_Changed" />
                    <NumberBox x:Name="UpdateIntervalBox" Header="Check every (hours)"
                               Minimum="1" Maximum="720" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <TextBlock x:Name="UpdateStatusHint" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <!-- ── File versions ────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xE81C;" />
                        <TextBlock Text="File versions" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4,8">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="How versions work"
                             Message="Each time a file is replaced by a newer copy, the old one is moved to a hidden versions folder in your cloud storage instead of being deleted. Open a file's details on the Files page to restore, save or delete a version. Versions use quota, so keep the limits sensible." />
                    <ToggleSwitch x:Name="VersioningToggle" Header="Keep previous versions of files"
                                  Toggled="Setting_Changed" />
                    <NumberBox x:Name="MaxVersionsBox" Header="Versions to keep per file (0 = unlimited)"
                               Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <NumberBox x:Name="VersionDaysBox" Header="Delete versions older than (days, 0 = never)"
                               Minimum="0" Maximum="3650" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                </StackPanel>
            </Expander>

            <!-- ── Explorer integration ─────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xEC50;" />
                        <TextBlock Text="Windows Explorer" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4,8">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                             Title="Experimental — test this before relying on it"
                             Message="This makes pool folders appear in Explorer's sidebar with online-only files that download when opened, like OneDrive or MEGA. It uses the Windows Cloud Files API, which an earlier build of Clouder crashed Explorer with. The code has since been rewritten, but it has NOT been verified end to end on this machine. If Explorer misbehaves, turn this off and restart Explorer from Task Manager." />
                    <ToggleSwitch x:Name="ExplorerToggle" Header="Show pools in Explorer with on-demand files"
                                  Toggled="Setting_Changed" />
                    <TextBlock x:Name="ExplorerStatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>

            <!-- ── Sync ─────────────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xE895;" />
                        <TextBlock Text="Sync" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4,8">
                    <NumberBox x:Name="SyncIntervalBox" Header="Sync interval (seconds)"
                               Minimum="30" Maximum="86400" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <StackPanel Spacing="4">
                        <ComboBox x:Name="ConflictBox" Header="Conflict resolution"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ConflictOptions}" SelectionChanged="Setting_Changed" />
                        <TextBlock x:Name="ConflictDescription" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <NumberBox x:Name="MaxConcurrentBox" Header="Max concurrent transfers"
                               Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <NumberBox x:Name="UploadLimitBox" Header="Upload speed limit (MB/s, 0 = unlimited)"
                               Minimum="0" Maximum="10000" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <NumberBox x:Name="DownloadLimitBox" Header="Download speed limit (MB/s, 0 = unlimited)"
                               Minimum="0" Maximum="10000" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                </StackPanel>
            </Expander>

            <!-- ── Storage ──────────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xEDA2;" />
                        <TextBlock Text="Storage" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4,8">
                    <NumberBox x:Name="CacheLimitBox" Header="Local cache size limit (MB, 0 = unlimited)"
                               Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <NumberBox x:Name="DehydrateDaysBox" Header="Auto-dehydrate files after (days, 0 = never)"
                               Minimum="0" Maximum="365" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <NumberBox x:Name="MinFreeDiskBox" Header="Minimum free local disk space (MB)"
                               Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                </StackPanel>
            </Expander>

            <!-- ── Striping ─────────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xE74C;" />
                        <TextBlock Text="File Striping" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4,8">
                    <NumberBox x:Name="StripeThresholdBox"
                               Header="Prompt for striping when file exceeds (MB)"
                               Minimum="1" Maximum="100000" SpinButtonPlacementMode="Inline"
                               ValueChanged="Setting_Changed" />
                    <ToggleSwitch x:Name="AutoReorgToggle"
                                  Header="Auto-reorganize files when a provider gets full"
                                  Toggled="Setting_Changed" />
                </StackPanel>
            </Expander>

            <!-- ── File Rules ───────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="&#xE71C;" />
                        <TextBlock Text="File Rules" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="4,8">
                    <TextBlock Text="Rules determine where specific files are placed. Higher priority rules are evaluated first."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Click="AddRule_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add Rule" />
                        </StackPanel>
                    </Button>
                    <ListView x:Name="RulesListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="12" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch IsOn="{Binding IsEnabled}" MinWidth="0"
                                                      Toggled="RuleToggled" Tag="{Binding RuleId}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{ThemeResource SystemAccentColor}"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="White" />
                                        </Border>
                                        <Button Grid.Column="3" Tag="{Binding RuleId}" Click="DeleteRule_Click"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>

            <!-- Save indicator -->
            <TextBlock x:Name="SaveIndicator" Text="" FontSize="12"
                       Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</Page>
