<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clouder_App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel Spacing="24">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Dashboard" />

            <!-- Total Storage Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Total Pooled Storage" />
                    <ProgressBar x:Name="TotalStorageBar" Maximum="100" Value="0" Height="8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TotalStorageUsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TotalStorageTotal" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Accounts Overview -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connected Accounts" />
            <ItemsRepeater x:Name="AccountsList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding ProviderGlyph}" FontSize="24" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Email}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <ProgressBar Maximum="100" Value="{Binding UsagePercent}" Height="4" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StorageText}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock x:Name="NoAccountsText" Text="No accounts connected. Go to Accounts to add one."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

            <!-- Pools Overview -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Storage Pools" />
            <ItemsRepeater x:Name="PoolsList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding StrategyLabel}" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ProgressBar Maximum="100" Value="{Binding UsagePercent}" Height="4" />
                                <TextBlock Text="{Binding MemberInfo}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock x:Name="NoPoolsText" Text="No pools configured. Go to Pools to create one."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
