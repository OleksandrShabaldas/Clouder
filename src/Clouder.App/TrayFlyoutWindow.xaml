<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Clouder_App.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Clouder"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────── -->
        <Grid Padding="16,14,12,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="30" Height="30" CornerRadius="15"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE753;" FontSize="15" Foreground="White" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Clouder" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="StatusLine" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button x:Name="PauseBtn" Click="TogglePause_Click" Padding="7,5"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Pause syncing">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13" />
                </Button>
                <Button Click="SyncNow_Click" Padding="7,5"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Sync now">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
                <Button Padding="7,5" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="13" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Open Clouder" Click="OpenApp_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Transfer manager" Click="OpenTransfers_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Settings" Click="OpenSettings_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Exit Clouder" Click="Exit_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Rings: pooled storage and sync health ────────────── -->
        <Grid Grid.Row="1" Padding="16,4,16,14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="46" Height="46">
                    <ProgressRing x:Name="StorageRing" IsIndeterminate="False" Value="0" Maximum="100"
                                  Width="46" Height="46" />
                    <TextBlock x:Name="StoragePct" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Storage" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="StorageText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="46" Height="46">
                    <ProgressRing x:Name="SyncRing" IsIndeterminate="False" Value="0" Maximum="100"
                                  Width="46" Height="46" />
                    <TextBlock x:Name="SyncPct" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="In sync" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="SyncText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ── Recent transfers ─────────────────────────────────── -->
        <Border Grid.Row="2" BorderThickness="0,1,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater x:Name="RecentList" Margin="0,4">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding MediaGlyph}" FontSize="16"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{Binding DirectionGlyph}" FontSize="9"
                                                      Foreground="{Binding DirectionBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="{Binding StatusGlyph}" FontSize="13"
                                              Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Text="No transfers yet.&#x0a;Drop a file into a pool folder."
                           TextAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ── Footer ───────────────────────────────────────────── -->
        <Grid Grid.Row="3" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <FontIcon x:Name="FooterIcon" Glyph="&#xE73E;" FontSize="13" />
                <TextBlock x:Name="FooterText" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Click="OpenTransfers_Click" Padding="8,5"
                    ToolTipService.ToolTip="Open the transfer manager">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8AB;" FontSize="13" />
                    <TextBlock Text="Transfers" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
